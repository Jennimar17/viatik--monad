# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_MONAD_NETWORK=testnet

# Accounts (Privy; gas is sponsored by Privy Fee sponsorship on Monad Testnet)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Dashboard > Configuration > App settings > verification key (offline token checks)
PRIVY_JWT_VERIFICATION_KEY=
# Sign-in emails bound to the seeded demo people: userId=email, comma separated
DEMO_ACCOUNTS=u_elena=test-0000@privy.io,u_maya=,u_alex=

# Ledger (Monad Testnet). Leave the ledger address blank to settle on the demo ledger.
VIATIK_LEDGER_ADDRESS=0x4BB74305A0e4ad5d55652B9d32b15d86d3E42908
TEST_USD_ADDRESS=0xE14D62136Bcc0C668755f69F04Cfa97b079BB246
# Reads, simulations and receipts (e.g. an Alchemy Monad Testnet URL)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Optional: log searches for confirmations (keep the public RPC when MONAD_RPC_URL is Alchemy Free)
MONAD_LOGS_RPC_URL=https://testnet-rpc.monad.xyz
# Signs role permits, runs the genesis and (unless LEDGER_KEEPER_PRIVATE_KEY is set) the keeper. Server only.
LEDGER_REGISTRAR_PRIVATE_KEY=
# Optional: a separate keeper key; it must match the ledger's keeper()
LEDGER_KEEPER_PRIVATE_KEY=
# Optional, at least 32 characters: enables POST /api/v1/keeper/run (header x-keeper-token) for the cron
KEEPER_TRIGGER_TOKEN=

# Data (NEXT_PUBLIC_DATA_SOURCE=api keeps real accounts on this database)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables POST /api/v1/admin/seed (header x-admin-token), at least 24 characters
ADMIN_SEED_TOKEN=

# Kimi (reads receipts and invoices). Optional: without a key the reader is off.
KIMI_API_KEY=
# Optional: defaults kimi-k3 and https://api.moonshot.ai/v1
KIMI_MODEL=
KIMI_BASE_URL=

# Alchemy webhook (funds arrived notices). Optional: without the signing key the route is off.
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_WEBHOOK_ID=
# Optional: lets sign-in add new accounts to the webhook
ALCHEMY_NOTIFY_AUTH_TOKEN=

# Contracts only (Foundry deploy scripts). Never set it on a server.
# DEPLOYER_PRIVATE_KEY=
