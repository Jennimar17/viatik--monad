# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_MONAD_NETWORK=testnet

# Accounts (Privy; gas is sponsored by Privy Fee sponsorship on Monad Testnet)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Dashboard > Configuration > App settings > verification key (offline token checks)
PRIVY_JWT_VERIFICATION_KEY=
# Sign-in emails bound to the seeded demo people: userId=email, comma separated
DEMO_ACCOUNTS=u_elena=test-0000@privy.io,u_maya=,u_alex=

# Ledger (Monad). The deployment on Monad Testnet; leave the ledger address blank to settle on the demo ledger
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VIATIK_LEDGER_ADDRESS=0x58e316B722006F5961ED3A6cDbF54A06b7C6d4C6
TEST_USD_ADDRESS=0xDcA5eE8982675C7bf7E8a2da84Cc2F1a4EFaD65C
LEDGER_DEPLOY_BLOCK=67762598
# Deployer for the contracts phase (a dedicated testnet wallet, never a personal one)
DEPLOYER_PRIVATE_KEY=

# Data (NEXT_PUBLIC_DATA_SOURCE=api keeps real accounts on this database)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables POST /api/v1/admin/seed (header x-admin-token), at least 24 characters
ADMIN_SEED_TOKEN=
